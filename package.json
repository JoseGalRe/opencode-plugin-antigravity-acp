{
  "name": "@josegalre/opencode-plugin-antigravity-acp",
  "version": "0.4.0",
  "description": "Google Antigravity in OpenCode through the official `agy acp` Agent Client Protocol server.",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "agy",
    "antigravity",
    "gemini",
    "opencode",
    "opencode-plugin"
  ],
  "homepage": "https://github.com/JoseGalRe/opencode-plugin-antigravity-acp#readme",
  "bugs": {
    "url": "https://github.com/JoseGalRe/opencode-plugin-antigravity-acp/issues"
  },
  "license": "MIT",
  "author": "Jose Adolfo Galdamez <jose@galre.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseGalRe/opencode-plugin-antigravity-acp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "vp pack",
    "test": "vp test",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "format:check": "vp format --check",
    "format:fix": "vp format",
    "cspell:check": "cspell lint",
    "ready": "vp check && vp test",
    "smoke": "node scripts/smoke-agy.ts --session",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.12.0",
    "@opencode/plugin": "2.4.1",
    "@types/node": "22.20.5",
    "cspell": "10.5.2",
    "vite-plus": "1.8.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.16.1",
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
